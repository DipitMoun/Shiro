{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiro.local/schema/org.shiro.moment.v1.schema.json",
  "title": "org.shiro.moment v1",
  "description": "Métadonnées d'un message Matrix ancré à un moment d'un épisode Shiro.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "work", "episode", "moments", "source", "capturedAt"],
  "properties": {
    "v": {
      "const": 1
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(anilist|mal|anidb|tvdb|tg|local):[A-Za-z0-9._:-]{1,128}$",
          "description": "Identifiant canonique principal."
        },
        "ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Alias connus, par schéma (anilist, mal, anidb, tvdb, tg, local)."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "format": {
          "type": "string",
          "enum": ["TV", "MOVIE", "OVA", "ONA", "SPECIAL", "OTHER"]
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(S[0-9]{2}E[0-9]{3,4}(\\.[0-9]{1,2})?|MAIN)$",
          "description": "S01E003, S00E001, S01E003.5 ou MAIN."
        },
        "number": {
          "type": "number",
          "minimum": 0
        },
        "season": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "enum": ["regular", "special", "film", "ova", "recap", "unknown"]
        },
        "numbering": {
          "type": "string",
          "enum": ["season", "absolute", "unknown"]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "moments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["positionMs"],
        "properties": {
          "positionMs": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string",
            "maxLength": 280
          },
          "lang": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          },
          "beforeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000,
            "default": 15000
          },
          "afterMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000,
            "default": 15000
          }
        }
      }
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Hash ou identifiant stable de la version de l'épisode."
        },
        "kind": {
          "type": "string",
          "enum": ["stream", "download", "local", "telegram"]
        },
        "lang": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "spoiler": {
      "type": "boolean",
      "default": false
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  }
}
